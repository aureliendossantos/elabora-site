      }
    },
    {
      "name": "the same highlight twice",
      "valid": false,
      "highlights": {
        "en": [
          "Import a course",
          "Import a course"
        ],
        "fr": [
          "Importer un module",
          "Garder sa narration"
        ]
      }
    },
    {
      "name": "an empty highlight",
      "valid": false,
      "highlights": {
        "en": [
          ""
        ],
        "fr": [
          "Importer un module"
        ]
      }
    },
    {
      "name": "markup in a highlight",

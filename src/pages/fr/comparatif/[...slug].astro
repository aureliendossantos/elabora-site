---
// The comparison pages in French (src/components/compare/ComparePage.astro, src/content/compare/fr/).
import type { GetStaticPaths } from 'astro';
import ComparePage from '../../../components/compare/ComparePage.astro';
import { comparePages } from '../../../lib/comparisons';

export const getStaticPaths = (async () =>
  (await comparePages('fr', { drafts: true })).map((page) => ({ params: { slug: page.data.slug || undefined }, props: { page } }))) satisfies GetStaticPaths;

const { page } = Astro.props;
---
<ComparePage page={page} />

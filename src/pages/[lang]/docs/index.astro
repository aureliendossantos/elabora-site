---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Docs from '../../../layouts/Docs.astro';
import { LOCALES, docsPath, useT, type Lang } from '../../../i18n';
import { DEV_BASE, devMap } from '../../../lib/core-docs';
import { manualNav, manualPages } from '../../../lib/docs-nav';
import { MANUAL_GROUPS } from '../../../content.config';

export const getStaticPaths = (() => LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const pages = await manualPages(lang);
const home = pages.find((page) => page.data.slug === '');
if (!home) throw new Error(`src/content/manual/${lang}/index.md is missing (slug '')`);
const { Content } = await render(home);
const path = docsPath(lang);
const paths = { fr: docsPath('fr'), en: docsPath('en') };
const nav = manualNav(pages, lang, path);
const first = pages.find((page) => page !== home);
const starts = devMap().sections.slice(0, 2).flatMap((section) => section.pages).slice(0, 4);
---
<Docs lang={lang} kind="manual" title={home.data.title} description={home.data.description} path={path} paths={paths} nav={nav} heading={home.data.title} lead={home.data.description} next={first && { title: first.data.title, href: docsPath(lang, first.data.slug) }}>
  <Content />
  <div class="docs-groups">
    {MANUAL_GROUPS.map((group) => {
      const inGroup = pages.filter((page) => page.data.group === group && page !== home);
      return inGroup.length > 0 && (
        <section class="docs-group" aria-labelledby={`group-${group}`}>
          <h2 id={`group-${group}`}>{t.docs.groups[group]}</h2>
          <ul class="docs-cards">
            {inGroup.map((page) => (
              <li><a href={docsPath(lang, page.data.slug)}><span class="docs-card-title">{page.data.title}</span><span class="docs-card-text">{page.data.description}</span></a></li>
            ))}
          </ul>
        </section>
      );
    })}
    <section class="docs-group docs-group-dev" aria-labelledby="group-developers">
      <h2 id="group-developers">{t.docs.developers}</h2>
      <p class="docs-group-note">{t.docs.developersNote}{lang !== 'en' && <> ({t.docs.inEnglish})</>}</p>
      <ul class="docs-cards">
        {starts.map((page) => (
          <li><a href={`${DEV_BASE}${page.id}/`} hreflang="en"><span class="docs-card-title">{page.title}</span><span class="docs-card-text">{page.description}</span></a></li>
        ))}
      </ul>
      <p class="docs-more"><a href={DEV_BASE} hreflang="en">{t.docs.developersLink} <span aria-hidden="true">→</span></a></p>
    </section>
  </div>
</Docs>

---
// The pricing page: the free app, Teams (a subscription, soon: early access by e-mail) and Enterprise (a demo). Three
// soft cards, Teams set forward; no price is shown for Teams yet. /fr/tarifs/ and /en/pricing/ (PRICING_PATHS).
import '../../styles/pricing.css';
import Base from '../../layouts/Base.astro';
import DemoButton from '../site/DemoButton.astro';
import DownloadButton from '../site/DownloadButton.astro';
import { CONTACT_EMAIL } from '../../site.config';
import { PRICING_PATHS, homePath, useT, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const p = t.pricing;
const early = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(p.plans.teams.subject)}`;
const check = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3.2 3.2L15 6.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Base lang={lang} title={`${p.title} · ${t.name}`} description={p.lead} paths={PRICING_PATHS} path={PRICING_PATHS[lang]}>
  <section class="pricing">
    <header class="section-head">
      <p class="eyebrow">{p.title}</p>
      <h1 class="title">{p.heading}</h1>
      <p class="lead">{p.lead}</p>
    </header>
    <ol class="plans">
      <li class="plan">
        <h2>{p.plans.app.name}</h2>
        <p class="plan-price">{p.plans.app.price}</p>
        <p class="plan-for">{p.plans.app.for}</p>
        <div class="plan-action"><DownloadButton lang={lang} more={`${homePath(lang)}#telecharger`} /></div>
        <ul>{p.plans.app.features.map((f) => <li><Fragment set:html={check} />{f}</li>)}</ul>
      </li>
      <li class="plan plan--teams">
        <h2>{p.plans.teams.name} <span class="plan-soon">{p.soon}</span></h2>
        <p class="plan-price">{p.plans.teams.price}</p>
        <p class="plan-for">{p.plans.teams.for}</p>
        <div class="plan-action"><a class="button" href={early}>{p.plans.teams.cta}</a></div>
        <p class="plan-includes">{p.plans.teams.includes}</p>
        <ul>{p.plans.teams.features.map((f) => <li><Fragment set:html={check} />{f}</li>)}</ul>
      </li>
      <li class="plan">
        <h2>{p.plans.business.name} <span class="plan-soon">{p.soon}</span></h2>
        <p class="plan-price">{p.plans.business.price}</p>
        <p class="plan-for">{p.plans.business.for}</p>
        <div class="plan-action"><DemoButton lang={lang} /></div>
        <p class="plan-includes">{p.plans.business.includes}</p>
        <ul>{p.plans.business.features.map((f) => <li><Fragment set:html={check} />{f}</li>)}</ul>
      </li>
    </ol>
    <p class="pricing-note">{p.note}</p>
  </section>
</Base>

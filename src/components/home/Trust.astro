---
// Ready for your organisation: six reasons, said simply and set apart by space alone, the LMS whose rules each package
// is checked against (the core's LMS profiles, docs/lms-profiles.md: documented rules, not field tests).
// The first three reasons are points of comparison (learning design checks, your files in an open format, the AI of
// your choice): the same facts as src/data/comparisons/elabora.json, which the comparison pages show. The home's content
// never links to those pages (the footer does) (docs/maintenance.md, « Comparison pages »). The home never sells the app as free: the price is
// a fact of the comparison pages only.
import { useT, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const icons = [
  '<path d="M2.5 11.5L15 5.5l12.5 6L15 17.5z"/><path d="M8 14.2v6.3c0 1.9 3.1 3.5 7 3.5s7-1.6 7-3.5v-6.3M27.5 11.5v7"/>',
  '<path d="M3 8.5A2.5 2.5 0 015.5 6H11l2.5 2.5h11A2.5 2.5 0 0127 11v12.5a2.5 2.5 0 01-2.5 2.5h-19A2.5 2.5 0 013 23.5z"/>',
  '<circle cx="15" cy="15" r="11"/><circle cx="15" cy="15" r="3.2" fill="currentColor" stroke="none"/><circle cx="23" cy="9.5" r="1.4" fill="currentColor" stroke="none"/><circle cx="7.5" cy="20.5" r="1.4" fill="currentColor" stroke="none"/>',
  '<path d="M7 4.5h10l6 6v15a1.5 1.5 0 01-1.5 1.5h-14A1.5 1.5 0 016 25.5v-19.5A1.5 1.5 0 017.5 4.5z"/><path d="M17 4.5v6h6M15 13.5v8M11.5 18l3.5 3.5 3.5-3.5"/>',
  '<circle cx="15" cy="6" r="2.4"/><path d="M6 10.5l9 2 9-2M15 12.5v6.5l-4.5 7.5M15 19l4.5 7.5"/>',
  '<path d="M5 6.5h20a2 2 0 012 2V20a2 2 0 01-2 2H13l-6 4.5V22H5a2 2 0 01-2-2V8.5a2 2 0 012-2z"/><path d="M9 12h12M9 16h8"/>',
];
const lms = ['Moodle', '360Learning', 'Cornerstone', 'Docebo', 'SuccessFactors', 'Workday'];
---
<section class="section" id="equipes" aria-labelledby="trust-title">
  <div class="section-head">
    <h2 id="trust-title" class="title reveal">{t.home.trust.title}</h2>
    <p class="lead reveal reveal--d1">{t.home.trust.lead}</p>
  </div>
  <ul class="reasons">
    {t.home.trust.items.map((item, i) => (
      <li class:list={['reveal', i % 3 === 1 && 'reveal--d1', i % 3 === 2 && 'reveal--d2']}>
        <svg viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </li>
    ))}
  </ul>
  <p class="lms reveal">{t.home.trust.lms} {lms.map((name, i) => <>{i > 0 && ', '}<b>{name}</b></>)}…</p>
</section>

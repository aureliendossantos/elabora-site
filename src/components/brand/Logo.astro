---
// The logo: the brand's written anchor and « elabora » in Newsreader roman, set as on the identity sheets (the
// anchor centred at 0.44 em, 0.3 em above the baseline, 1.02 em high; the word from 1.14 em). The anchor's drawing
// follows its size, as the app's icons do: favicon under 32 px, icon up to 128, poster above.
import favicon from '../../assets/brand/ancre-favicon.svg?raw';
import icone from '../../assets/brand/ancre-icone.svg?raw';
import affiche from '../../assets/brand/ancre-affiche.svg?raw';

interface Props {
  /** The word's size in px (the anchor is 1.02 times as high). */
  size?: number;
  /** The anchor alone. */
  mark?: boolean;
}
const { size = 23, mark = false } = Astro.props;
const S = size;
const svg = S * 1.02 < 32 ? favicon : S * 1.02 < 128 ? icone : affiche;
const [x0, y0, w, h] = (svg.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 1 1').split(/\s+/).map(Number) as [number, number, number, number];
const d = svg.match(/ d="([^"]+)"/)?.[1] ?? '';
const ah = S * 1.02, s = ah / h, cx = S * 0.44, cy = -S * 0.3;
const tx = cx - (x0 + w / 2) * s, ty = cy - (y0 + h / 2) * s;
const width = mark ? S * 1.0 : S * 4.5;
const r = (n: number) => Math.round(n * 1000) / 1000;
---
<svg viewBox={`${r(-S * 0.08)} ${r(-S * 0.92)} ${r(width)} ${r(S * 1.3)}`} width={r(width)} height={r(S * 1.3)} aria-hidden="true" focusable="false">
  <path d={d} fill="currentColor" fill-rule="evenodd" transform={`matrix(${r(s)} 0 0 ${r(s)} ${r(tx)} ${r(ty)})`} />
  {!mark && <text x={r(S * 1.14)} y="0" font-family="Newsreader, Newsreader Fallback, serif" font-size={S} font-weight="400" letter-spacing={r(-S * 0.01)} fill="currentColor">elabora</text>}
</svg>

---
import type { Lang } from '../i18n';
import { changelogPath, type ReleaseRecord } from '../lib/releases';
interface Props { release: ReleaseRecord; lang: Lang; detail?: boolean }
const { release, lang, detail = false } = Astro.props;
const date = new Intl.DateTimeFormat(lang, { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(release.date));
---
<article class="release-entry">
  <p class="release-meta"><time datetime={release.date}>{date}</time> <span>· Elabora {release.version}</span></p>
  <h2>{detail ? release.title[lang] : <a href={changelogPath(lang, release.version)}>{release.title[lang]}</a>}</h2>
  <ul class="release-highlights">{release.highlights[lang].map(line => <li>{line}</li>)}</ul>
  {detail && <>
    <h3>{lang === 'fr' ? 'Toutes les améliorations' : 'All changes'}</h3>
    <ul>{release.entries.map(entry => <li id={entry.id} lang={entry.text[lang] ? lang : 'en'}>{entry.text[lang] ?? entry.text.en}</li>)}</ul>
    <p class="release-core"><a href={`https://github.com/aureliendossantos/elabora-core/tree/${release.core.revision}`}>{lang === 'fr' ? 'Version du cœur intégrée :' : 'Included core version:'} {release.core.version}</a></p>
  </>}
</article>

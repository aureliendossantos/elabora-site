---
// « Réserver une démo », the action for organisations: a message to the team for now, in the page's language. A button,
// a small one (the header), or a link beside the download (the end of the home).
import { DEMO_URL } from '../../site.config';
import { useT, type Lang } from '../../i18n';

interface Props { lang: Lang; look?: 'button' | 'small' | 'link'; label?: string }
const { lang, look = 'button', label } = Astro.props;
const t = useT(lang);
---
<a class:list={look === 'link' ? 'more' : ['button', { 'button--small': look === 'small' }]} href={DEMO_URL(t.footer.demoSubject)}>{label ?? t.nav.demo}</a>

{
  "name": "elabora-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "pnpm run schemas:check && pnpm run docs:check && pnpm run releases:check",
    "build": "astro build",
    "postbuild": "pnpm run schemas:check dist/schemas && pagefind --site dist --output-subdir pagefind",
    "check": "pnpm run schemas:check && pnpm run docs:check && pnpm run releases:check && astro check && tsc --noEmit",
    "test": "node --test scripts/schemas.test.mjs scripts/core-docs.test.mjs scripts/releases.test.mjs scripts/chat-models.test.mjs scripts/comparisons.test.mjs",
    "schemas:sync": "node scripts/schemas.mjs sync",
    "schemas:check": "node scripts/schemas.mjs check",
    "schemas:verify": "node scripts/schemas.mjs verify",
    "docs:sync": "node scripts/core-docs.mjs sync",
    "docs:check": "node scripts/core-docs.mjs check",
    "links": "node scripts/check-links.mjs",
    "shoot": "node scripts/shoot.mjs",
    "check:home": "node scripts/check-home.mjs",
    "search-console": "node scripts/search-console.mjs",
    "deploy": "pnpm run releases:sync && pnpm run build && pnpm run releases:guard && wrangler deploy",
    "postdeploy": "pnpm run schemas:verify",
    "releases:sync": "node scripts/releases.mjs sync",
    "releases:check": "node scripts/releases.mjs check",
    "releases:guard": "node scripts/releases.mjs guard"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.3.8",
    "satteri": "0.10.5",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.5",
    "pagefind": "^1.5.2",
    "playwright": "^1.64.1",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  },
  "packageManager": "pnpm@11.22.0"
}
